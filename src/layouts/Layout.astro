---
import '@fontsource/anton';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** JSON-LD-Objekte, werden als <script type="application/ld+json"> ausgegeben */
  schema?: object[];
  noindex?: boolean;
}

const {
  title = `${site.title} — Roger G. & Jana Jansen`,
  description = site.description,
  schema = [],
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.domain).href.replace(/\/$/, '') || site.domain;
---

<!doctype html>
<html lang="de" class="js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={site.feedUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.jpg', site.domain).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#01516a" />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="wordmark" href="/#top" aria-label="G-Laber Podcast — Startseite">
          G-Laber
          <svg class="bubble-dot" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <path fill="currentColor" d="M12 2a10 8.5 0 0 1 10 8.5A10 8.5 0 0 1 12 19c-.9 0-1.8-.1-2.6-.3L4 21l1.6-4.2A8.4 8.4 0 0 1 2 10.5 10 8.5 0 0 1 12 2Z"/>
          </svg>
        </a>
        <nav aria-label="Hauptnavigation">
          <a href="/#folgen">Folgen</a>
          <a href="/#hosts">Über uns</a>
          <a href="/#kontakt">Kontakt</a>
          <a class="btn btn-primary btn-nav" href="/#hoeren">Anhören</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <span class="wordmark" aria-hidden="true">G-Laber</span>
          <p>{site.claim}</p>
        </div>
        <nav class="footer-links" aria-label="Podcast-Plattformen">
          <a href={site.platforms.apple} rel="noopener">Apple Podcasts</a>
          <a href={site.platforms.spotify} rel="noopener">Spotify</a>
          <a href={site.feedUrl} rel="noopener">RSS-Feed</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </nav>
        <nav class="footer-links" aria-label="Soziale Medien und Rechtliches">
          <a href={site.hosts[0].links[0].url} rel="noopener">Instagram Roger</a>
          <a href={site.hosts[1].links[0].url} rel="noopener">Instagram Jana</a>
          <a href="/impressum">Impressum</a>
          <a href="/datenschutz">Datenschutz</a>
        </nav>
      </div>
      <div class="container footer-meta">
        <p>© 2026 Roger G. &amp; Jana Jansen · Eine Produktion mit <a href={site.production.url} rel="noopener">{site.production.label}</a></p>
      </div>
    </footer>

    <script src="../scripts/app.js"></script>

    <style>
      .skip-link {
        position: absolute;
        left: -999px;
        top: 0.75rem;
        z-index: 100;
        padding: 0.6rem 1.1rem;
        border-radius: 999px;
        background: var(--apricot);
        color: var(--petrol-darker);
        font-weight: 700;
        text-decoration: none;
      }
      .skip-link:focus { left: 0.75rem; }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--petrol-darker) 72%, transparent);
        -webkit-backdrop-filter: blur(14px);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--line);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-block: 0.8rem;
      }
      .wordmark {
        display: inline-flex;
        align-items: baseline;
        gap: 0.3rem;
        font-family: var(--font-display);
        font-size: 1.55rem;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        color: var(--white);
        text-decoration: none;
        line-height: 1;
      }
      .bubble-dot { color: var(--apricot); translate: 0 1px; }

      .site-header nav {
        display: flex;
        align-items: center;
        gap: clamp(0.9rem, 2.5vw, 1.8rem);
      }
      .site-header nav a:not(.btn) {
        font-size: var(--text-sm);
        font-weight: 600;
        text-decoration: none;
        color: color-mix(in srgb, var(--white) 88%, transparent);
        transition: color 0.2s;
      }
      .site-header nav a:not(.btn):hover { color: var(--apricot); }
      .btn-nav { padding: 0.5rem 1.15rem; }
      @media (max-width: 40rem) {
        .site-header nav a:not(.btn) { display: none; }
      }

      .site-footer {
        background: var(--petrol-darker);
        border-top: 1px solid var(--line);
        padding-block: 3.5rem 2rem;
      }
      .footer-inner {
        display: grid;
        gap: 2.5rem;
        grid-template-columns: 1fr;
      }
      @media (min-width: 48rem) {
        .footer-inner { grid-template-columns: 2fr 1fr 1fr; }
      }
      .footer-brand .wordmark { font-size: 2rem; }
      .footer-brand p {
        margin-top: 0.9rem;
        max-width: 26rem;
        color: color-mix(in srgb, var(--white) 72%, transparent);
      }
      .footer-links { display: grid; gap: 0.65rem; align-content: start; }
      .footer-links a {
        width: fit-content;
        font-size: var(--text-sm);
        color: color-mix(in srgb, var(--white) 78%, transparent);
        text-decoration: none;
        transition: color 0.2s;
      }
      .footer-links a:hover { color: var(--apricot); }
      .footer-meta {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--line);
        font-size: var(--text-xs);
        color: color-mix(in srgb, var(--white) 55%, transparent);
      }
      .footer-meta a { color: inherit; }
    </style>
  </body>
</html>
