---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { site, host } from '../data/site';
import Wordmark from '../components/Wordmark.astro';
import Brush from '../components/Brush.astro';

interface Props {
  title?: string;
  description?: string;
  /** JSON-LD-Objekte, werden als <script type="application/ld+json"> ausgegeben */
  schema?: object[];
  noindex?: boolean;
}

const {
  title = `${site.title} — Jana Jansen & Roger G.`,
  description = site.description,
  schema = [],
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.domain).href.replace(/\/$/, '') || site.domain;

const nav = [
  { href: '/#folgen', label: 'Folgen' },
  { href: '/#hosts', label: 'Über uns' },
  { href: '/#kontakt', label: 'Kontakt' },
];
---

<!doctype html>
<html lang="de" class="js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={site.feedUrl} />
    <!-- Display-Schrift früh laden: das Wortbild im Hero ist das erste, was zählt -->
    <link rel="preload" href="/fonts/bebas-neue-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.jpg', site.domain).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="G-Laber — der Podcast mit Jana Jansen und Roger G." />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b0b0c" />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>

    <header class="site-header">
      <div class="container container-wide header-inner">
        <Wordmark href="/#top" class="header-mark" />

        <nav class="nav-desktop" aria-label="Hauptnavigation">
          {nav.map((n) => <a class="nav-link" href={n.href}>{n.label}</a>)}
          <a class="btn btn-primary btn-nav" href="/#hoeren">Anhören</a>
        </nav>

        <button
          class="nav-toggle"
          type="button"
          data-nav-toggle
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span class="nav-toggle-bars" aria-hidden="true"><span></span><span></span></span>
          <span class="nav-toggle-label">Menü</span>
        </button>
      </div>
      <Brush variant="stroke" color="var(--pink)" class="header-rule" />
    </header>

    <!-- Mobile-Navigation: Vollbild-Overlay, Steuerung in src/scripts/app.js -->
    <div class="nav-overlay" id="mobile-nav" data-nav-overlay hidden>
      <nav aria-label="Hauptnavigation (mobil)">
        {nav.map((n) => <a class="nav-overlay-link" href={n.href}>{n.label}</a>)}
        <a class="nav-overlay-link accent" href="/#hoeren">Anhören</a>
      </nav>
      <div class="nav-overlay-meta">
        <a href={site.platforms.spotify} rel="noopener">Spotify</a>
        <a href={site.platforms.apple} rel="noopener">Apple Podcasts</a>
        <a href={site.feedUrl} rel="noopener">RSS</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container container-wide">
        <div class="footer-grid">
          <div class="footer-cta">
            <p class="label label-pink">Jeden Donnerstag neu</p>
            <p class="footer-claim">{site.claim}</p>
            <a class="btn btn-primary" href={site.platforms.spotify} rel="noopener">Folge hören</a>
          </div>

          <nav class="footer-links" aria-label="Podcast-Plattformen">
            <h2 class="footer-head">Hören</h2>
            <a class="link-brush" href={site.platforms.spotify} rel="noopener">Spotify</a>
            <a class="link-brush" href={site.platforms.apple} rel="noopener">Apple Podcasts</a>
            <a class="link-brush" href={site.feedUrl} rel="noopener">RSS-Feed</a>
          </nav>

          <nav class="footer-links" aria-label="Soziale Medien">
            <h2 class="footer-head">Folgen</h2>
            <a class="link-brush" href={host('jana').links[0].url} rel="noopener">Instagram Jana</a>
            <a class="link-brush" href={host('roger').links[0].url} rel="noopener">Instagram Roger</a>
            <a class="link-brush" href={host('jana').links[1].url} rel="noopener">Tickets Jana</a>
            <a class="link-brush" href={host('roger').links[1].url} rel="noopener">Merch-Shop</a>
          </nav>

          <nav class="footer-links" aria-label="Kontakt und Rechtliches">
            <h2 class="footer-head">Kleingedrucktes</h2>
            <a class="link-brush" href={`mailto:${site.email}`}>{site.email}</a>
            <a class="link-brush" href="/impressum">Impressum</a>
            <a class="link-brush" href="/datenschutz">Datenschutz</a>
          </nav>
        </div>

        <!-- Wortbild als grafischer Abschluss: skaliert mit der Breite -->
        <div class="footer-mark-wrap">
          <Wordmark class="footer-mark" />
        </div>

        <p class="footer-meta">
          © 2026 Jana Jansen &amp; Roger G. · Eine Produktion mit
          <a class="link-brush" href={site.production.url} rel="noopener">{site.production.label}</a>
        </p>
      </div>
    </footer>

    <script src="../scripts/app.js"></script>

    <style>
      .skip-link {
        position: absolute;
        left: -999px;
        top: 0.75rem;
        z-index: 100;
        padding: 0.7rem 1.2rem;
        background: var(--pink);
        color: var(--black);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        text-decoration: none;
      }
      .skip-link:focus { left: 0.75rem; }

      /* ---------------- Header ---------------- */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 60;
        background: var(--black);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-block: 0.7rem;
      }
      .header-mark {
        font-size: clamp(1.7rem, 4vw, 2.25rem);
        /* kleiner Grad → kleinerer Versatz, sonst matscht das Wortbild zu */
        text-shadow: -0.018em -0.018em 0 var(--orange), 0.024em 0.024em 0 var(--pink);
      }
      /* Der Pinselstrich ersetzt die Trennlinie unter dem Header */
      .header-rule { height: 0.5rem; margin-top: -0.15rem; }

      .nav-desktop {
        display: flex;
        align-items: center;
        gap: clamp(1.1rem, 2.5vw, 2.25rem);
      }
      .nav-link {
        font-size: var(--text-xs);
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        text-decoration: none;
        color: var(--white);
        padding-block: 0.6rem;
        transition: color 0.2s;
      }
      .nav-link:hover { color: var(--pink); }
      .btn-nav { min-height: 2.75rem; padding: 0.6rem 1.35rem; --hard: 0.35rem; }

      /* ---------------- Mobile-Navigation ---------------- */
      .nav-toggle {
        display: none;
        align-items: center;
        gap: 0.6rem;
        min-height: 2.75rem;
        padding: 0.5rem 0.9rem;
        background: transparent;
        border: 3px solid var(--white);
        border-radius: 2px;
        color: var(--white);
        font-size: var(--text-xs);
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }
      .nav-toggle-bars {
        display: grid;
        gap: 4px;
        width: 20px;
      }
      .nav-toggle-bars span {
        display: block;
        height: 3px;
        background: currentColor;
        transition: transform 0.25s var(--ease-out);
      }
      .nav-toggle[aria-expanded='true'] { background: var(--pink); border-color: var(--pink); color: var(--black); }
      .nav-toggle[aria-expanded='true'] .nav-toggle-bars span:first-child { transform: translateY(3.5px) rotate(45deg); }
      .nav-toggle[aria-expanded='true'] .nav-toggle-bars span:last-child { transform: translateY(-3.5px) rotate(-45deg); }

      .nav-overlay {
        position: fixed;
        inset: 0;
        z-index: 55;
        display: grid;
        align-content: center;
        gap: 2.5rem;
        padding: 6rem var(--gutter) 3rem;
        background: var(--black);
        overflow-y: auto;
      }
      .nav-overlay[hidden] { display: none; }
      .nav-overlay nav { display: grid; gap: 0.35rem; }
      .nav-overlay-link {
        font-family: var(--font-display);
        font-size: clamp(2.75rem, 13vw, 4.5rem);
        line-height: 1;
        text-transform: uppercase;
        text-decoration: none;
        color: var(--white);
      }
      .nav-overlay-link:hover, .nav-overlay-link:focus-visible { color: var(--pink); }
      .nav-overlay-link.accent { color: var(--orange); }
      .nav-overlay-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem 1.5rem;
        padding-top: 1.5rem;
        border-top: 3px solid var(--line);
        font-size: var(--text-sm);
        font-weight: 700;
      }
      .nav-overlay-meta a { color: var(--gray); text-decoration: none; }
      .nav-overlay-meta a:hover { color: var(--orange); }

      @media (max-width: 52rem) {
        .nav-desktop { display: none; }
        .nav-toggle { display: inline-flex; }
      }

      /* ---------------- Footer ---------------- */
      .site-footer {
        background: var(--black);
        border-top: 3px solid var(--line);
        padding-block: clamp(3rem, 6vw, 5rem) 1.5rem;
      }
      .footer-grid {
        display: grid;
        gap: 2.5rem;
        grid-template-columns: 1fr;
      }
      @media (min-width: 40rem) { .footer-grid { grid-template-columns: repeat(3, 1fr); } }
      @media (min-width: 64rem) { .footer-grid { grid-template-columns: 1.4fr repeat(3, 1fr); } }

      .footer-cta { display: grid; gap: 0.9rem; justify-items: start; max-width: 24rem; }
      @media (min-width: 40rem) and (max-width: 63.999rem) { .footer-cta { grid-column: 1 / -1; } }
      .footer-claim { color: var(--gray); }

      .footer-links { display: grid; gap: 0.7rem; align-content: start; justify-items: start; }
      .footer-head {
        font-size: var(--display-sm);
        color: var(--white);
        margin-bottom: 0.2rem;
      }
      .footer-links a { color: var(--gray); text-decoration: none; }
      .footer-links a:hover { color: var(--white); }

      .footer-mark-wrap {
        margin-top: clamp(3rem, 7vw, 6rem);
        /* Das Wortbild soll die volle Breite füllen und darf unten anschneiden */
        overflow: hidden;
        line-height: 0.72;
      }
      .footer-mark {
        font-size: clamp(3.5rem, 34.5vw, 37rem);
        letter-spacing: -0.005em;
        color: var(--white);
        text-shadow: -0.022em -0.022em 0 var(--orange), 0.03em 0.03em 0 var(--pink);
      }

      .footer-meta {
        margin-top: 1.75rem;
        padding-top: 1.25rem;
        border-top: 3px solid var(--line);
        font-size: var(--text-xs);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        font-weight: 700;
        color: var(--gray-dim);
      }
    </style>
  </body>
</html>
