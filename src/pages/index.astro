---
import Layout from '../layouts/Layout.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import { site } from '../data/site';
import feed from '../data/episodes.json';

const [latest, ...older] = feed.episodes;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'PodcastSeries',
    name: site.title,
    description: site.description,
    url: site.domain,
    image: `${site.domain}/img/cover-1080.webp`,
    inLanguage: 'de',
    genre: ['Comedy', 'Gesellschaft & Kultur'],
    webFeed: site.feedUrl,
    author: site.hosts.map((h) => ({ '@type': 'Person', name: h.name })),
  },
  ...feed.episodes.map((ep) => ({
    '@context': 'https://schema.org',
    '@type': 'PodcastEpisode',
    name: ep.title,
    episodeNumber: ep.episodeNumber,
    datePublished: new Date(ep.pubDate).toISOString().slice(0, 10),
    timeRequired: `PT${Math.floor(ep.durationSeconds / 60)}M`,
    description: ep.description.split('\n\n')[0],
    url: `${site.domain}/#folge-${ep.episodeNumber}`,
    partOfSeries: { '@type': 'PodcastSeries', name: site.title, url: site.domain },
    associatedMedia: { '@type': 'MediaObject', contentUrl: ep.audioUrl },
  })),
];
---

<Layout schema={schema}>
  <!-- ================= HERO ================= -->
  <section class="hero" id="top">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="hero-badge"><span class="pulse" aria-hidden="true"></span> Neue Folge jeden Donnerstag</p>
        <h1 class="hero-title">
          <span class="line">G-Laber</span>
          <span class="line accent">Podcast</span>
        </h1>
        <p class="hero-claim">
          Roger G. &amp; Jana Jansen — hier sind alle Landratten und Kanalmäuse richtig.
          {site.claim}
        </p>
        <div class="hero-actions" id="hoeren">
          <a class="btn btn-primary" href={site.platforms.spotify} rel="noopener">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm4.6 14.5a.7.7 0 0 1-1 .2c-2.6-1.6-6-2-9.9-1.1a.7.7 0 1 1-.3-1.4c4.2-1 7.9-.5 10.9 1.3.3.2.4.7.3 1Zm1.2-2.9a.9.9 0 0 1-1.2.3c-3-1.9-7.7-2.4-11.3-1.3a.9.9 0 1 1-.5-1.7c4.1-1.2 9.2-.6 12.7 1.5.4.2.5.8.3 1.2Zm.1-3a1 1 0 0 1-1.4.4C13 9 8 8.8 4.9 9.7a1.1 1.1 0 0 1-.6-2.1c3.6-1 9.2-.8 13.2 1.5.5.3.7 1 .4 1.5Z"/></svg>
            Auf Spotify hören
          </a>
          <a class="btn btn-ghost" href={site.platforms.apple} rel="noopener">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 1 4.3 19c-.5.3-1-.1-1.1-.6l-.4-1.8a8 8 0 1 0-5.6 0l-.4 1.8c-.1.5-.6.9-1.1.6A10 10 0 0 1 12 2Zm0 4.5a5.5 5.5 0 0 1 2.6 10.3l-.5-2.1a3.5 3.5 0 1 0-4.2 0l-.5 2.1A5.5 5.5 0 0 1 12 6.5Zm0 8.3c.9 0 1.6.6 1.5 1.4l-.7 4.3c-.1.4-.4.7-.8.7s-.7-.3-.8-.7l-.7-4.3c-.1-.8.6-1.4 1.5-1.4Zm0-6a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6Z"/></svg>
            Apple Podcasts
          </a>
          <a class="hero-rss" href={site.feedUrl} rel="noopener">RSS-Feed</a>
        </div>
      </div>

      <div class="hero-art" aria-hidden="true">
        <img
          src="/img/cover-768.webp"
          srcset="/img/cover-480.webp 480w, /img/cover-768.webp 768w, /img/cover-1080.webp 1080w"
          sizes="(min-width: 60rem) 30rem, 78vw"
          width="768" height="768"
          alt=""
          fetchpriority="high"
        />
      </div>
    </div>
    <div class="hero-wave" aria-hidden="true">
      <svg viewBox="0 0 1440 70" preserveAspectRatio="none"><path fill="var(--petrol-deep)" d="M0 45c180-38 340-38 520-8s380 32 560 4 300-30 360-22v51H0Z"/></svg>
    </div>
  </section>

  <!-- ================= NEUESTE FOLGE ================= -->
  <section class="section latest" aria-labelledby="latest-heading">
    <div class="container" data-reveal-group>
      <p class="kicker" data-reveal>Frisch aus der Kombüse</p>
      <h2 class="section-title" id="latest-heading" data-reveal>Die neueste Folge</h2>
      <div data-reveal>
        <EpisodeCard episode={latest} variant="feature" />
      </div>
    </div>
  </section>

  <!-- ================= ALLE FOLGEN ================= -->
  <section class="section archive" id="folgen" aria-labelledby="folgen-heading">
    <div class="container" data-reveal-group>
      <p class="kicker archive-kicker" data-reveal>Zum Nachhören</p>
      <h2 class="section-title archive-title" id="folgen-heading" data-reveal>Alle Folgen</h2>
      <div class="archive-list">
        {older.map((ep) => (
          <div data-reveal>
            <EpisodeCard episode={ep} />
          </div>
        ))}
      </div>
      <p class="archive-note" data-reveal>
        Alle Folgen gibt’s überall, wo es Podcasts gibt —
        <a href={site.platforms.spotify} rel="noopener">Spotify</a>,
        <a href={site.platforms.apple} rel="noopener">Apple Podcasts</a> und per
        <a href={site.feedUrl} rel="noopener">RSS</a>.
      </p>
    </div>
  </section>

  <!-- ================= HOSTS ================= -->
  <section class="section hosts" id="hosts" aria-labelledby="hosts-heading">
    <div class="container" data-reveal-group>
      <p class="kicker" data-reveal>Wer labert hier eigentlich?</p>
      <h2 class="section-title" id="hosts-heading" data-reveal>Ostsee trifft Rheinland</h2>
      <div class="hosts-grid">
        {site.hosts.map((host) => (
          <article class="host-card" data-reveal>
            <img src={host.image} width="480" height="600" alt={`${host.name}, ${host.role}`} loading="lazy" />
            <div class="host-body">
              <h3>{host.name}</h3>
              <p class="host-role">{host.role}</p>
              <p class="host-bio">{host.bio}</p>
              <div class="host-links">
                {host.links.map((l) => (
                  <a class="btn btn-ghost" href={l.url} rel="noopener">{l.label}</a>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= KONTAKT ================= -->
  <section class="section kontakt" id="kontakt" aria-labelledby="kontakt-heading">
    <div class="container kontakt-inner" data-reveal-group>
      <div class="speech-bubble" data-reveal>
        <p class="kicker">Ahoi, schreibt uns</p>
        <h2 class="section-title" id="kontakt-heading">Themen, Fragen, Seemannsgarn?</h2>
        <p class="kontakt-text">
          Eure Geschichten landen in der nächsten Folge. Immer her damit — Flaschenpost
          wird auch akzeptiert, E-Mail ist schneller.
        </p>
        <a class="btn btn-primary kontakt-btn" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .section-title {
    font-size: var(--display-lg);
    margin: 0.9rem 0 2.2rem;
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: clip;
    background:
      radial-gradient(60rem 40rem at 85% -10%, var(--petrol-soft), transparent 60%),
      var(--petrol);
  }
  .hero-inner {
    display: grid;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: clamp(3.5rem, 3rem + 5vw, 7.5rem) clamp(5rem, 4rem + 6vw, 9rem);
  }
  @media (min-width: 60rem) {
    .hero-inner { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--apricot);
    background: color-mix(in srgb, var(--petrol-darker) 45%, transparent);
  }
  .pulse {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--apricot);
    animation: pulse 2.2s ease-out infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--apricot) 60%, transparent); }
    70% { box-shadow: 0 0 0 10px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  .hero-title {
    font-size: var(--display-xl);
    margin-top: 1.4rem;
    letter-spacing: 0.01em;
  }
  .hero-title .line { display: block; }
  .hero-title .accent {
    color: var(--apricot);
    -webkit-text-stroke: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-title .line {
      animation: rise 0.9s var(--ease-out) both;
    }
    .hero-title .line.accent { animation-delay: 0.12s; }
    .hero-copy > :not(.hero-title), .hero-art {
      animation: fade 0.9s var(--ease-out) 0.35s both;
    }
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(0.6em); }
    to { opacity: 1; transform: none; }
  }
  @keyframes fade {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }

  .hero-claim {
    margin-top: 1.6rem;
    max-width: 34rem;
    font-size: var(--text-lg);
    color: color-mix(in srgb, var(--white) 88%, transparent);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    margin-top: 2.2rem;
    scroll-margin-top: 6rem;
  }
  .hero-rss {
    font-size: var(--text-sm);
    font-weight: 650;
    color: color-mix(in srgb, var(--white) 75%, transparent);
    text-underline-offset: 4px;
    transition: color 0.2s;
  }
  .hero-rss:hover { color: var(--apricot); }

  .hero-art { position: relative; }
  .hero-art img {
    width: min(30rem, 100%);
    margin-inline: auto;
    border-radius: var(--radius-lg);
    rotate: 2.5deg;
    box-shadow: var(--shadow-card);
    transition: rotate 0.5s var(--ease-out), transform 0.5s var(--ease-out);
  }
  .hero-art:hover img { rotate: 0deg; transform: scale(1.015); }
  .hero-art::before {
    content: '';
    position: absolute;
    inset: 8% -4% -6% 6%;
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--apricot) 22%, transparent);
    rotate: -2deg;
    z-index: -1;
  }

  .hero-wave {
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    line-height: 0;
  }
  .hero-wave svg { width: 100%; height: clamp(28px, 5vw, 70px); }

  /* ---------- Neueste Folge ---------- */
  .latest {
    background: var(--petrol-deep);
    padding-top: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  /* ---------- Archiv (helle Sektion) ---------- */
  .archive {
    background: var(--paper);
    color: var(--ink);
  }
  .archive-kicker { color: var(--burgundy); }
  .archive-list { display: grid; gap: 1.5rem; }
  .archive-note {
    margin-top: 2.5rem;
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }
  .archive-note a {
    color: var(--burgundy);
    font-weight: 650;
    text-underline-offset: 3px;
  }

  /* ---------- Hosts ---------- */
  .hosts { background: var(--petrol); }
  .hosts-grid {
    display: grid;
    gap: 1.75rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 48rem) {
    .hosts-grid { grid-template-columns: 1fr 1fr; }
  }
  .host-card {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: var(--radius-lg);
    overflow: clip;
    background: var(--petrol-deep);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-card);
  }
  .host-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top;
  }
  .host-body { padding: clamp(1.3rem, 2.5vw, 2rem); }
  .host-body h3 { font-size: var(--display-md); }
  .host-role {
    margin-top: 0.4rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--apricot);
  }
  .host-bio {
    margin-top: 0.9rem;
    color: color-mix(in srgb, var(--white) 82%, transparent);
  }
  .host-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.4rem;
  }
  .host-links .btn { padding: 0.55rem 1.2rem; }

  /* ---------- Kontakt ---------- */
  .kontakt { background: var(--petrol-deep); }
  .kontakt-inner { display: grid; justify-items: center; }
  .speech-bubble {
    position: relative;
    max-width: 46rem;
    text-align: center;
    padding: clamp(2rem, 4vw, 3.5rem);
    border-radius: var(--radius-lg);
    background: var(--petrol);
    border: 1px solid var(--line);
  }
  .speech-bubble::after {
    content: '';
    position: absolute;
    left: 14%;
    bottom: -17px;
    width: 34px;
    height: 18px;
    background: var(--petrol);
    border-inline: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    clip-path: polygon(0 0, 100% 0, 22% 100%);
  }
  .speech-bubble .section-title { margin-bottom: 1.2rem; }
  .kontakt-text {
    max-width: 34rem;
    margin-inline: auto;
    color: color-mix(in srgb, var(--white) 85%, transparent);
  }
  .kontakt-btn { margin-top: 1.8rem; }
</style>
