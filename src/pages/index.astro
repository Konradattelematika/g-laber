---
import Layout from '../layouts/Layout.astro';
import Kinetic from '../components/Kinetic.astro';
import Brush from '../components/Brush.astro';
import Marquee from '../components/Marquee.astro';
import FeaturedEpisode from '../components/FeaturedEpisode.astro';
import EpisodeRow from '../components/EpisodeRow.astro';
import { site } from '../data/site';
import { prepare } from '../lib/episode';
import feed from '../data/episodes.json';

const [latest, ...older] = feed.episodes;
const latestPrepared = prepare(latest);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'PodcastSeries',
    name: site.title,
    description: site.description,
    url: site.domain,
    image: `${site.domain}/img/cover-1080.webp`,
    inLanguage: 'de',
    genre: ['Comedy', 'Gesellschaft & Kultur'],
    webFeed: site.feedUrl,
    author: site.hosts.map((h) => ({ '@type': 'Person', name: h.name })),
  },
  ...feed.episodes.map((ep) => {
    const e = prepare(ep);
    return {
      '@context': 'https://schema.org',
      '@type': 'PodcastEpisode',
      name: e.title,
      // Bonus/Trailer haben keine Folgennummer -> Feld weglassen, Anker über Slug.
      ...(e.episodeNumber != null ? { episodeNumber: e.episodeNumber } : {}),
      datePublished: e.dateISO,
      timeRequired: `PT${Math.floor(e.durationSeconds / 60)}M`,
      description: e.teaser,
      url: `${site.domain}/#${e.anchorId}`,
      partOfSeries: { '@type': 'PodcastSeries', name: site.title, url: site.domain },
      associatedMedia: { '@type': 'MediaObject', contentUrl: e.audioUrl },
    };
  }),
];

const tickerItems = [
  'G-Laber',
  'Neue Folge jeden Donnerstag',
  'Jana Jansen',
  'Roger G.',
  'Ach, alles halb so wild',
];
---

<Layout schema={schema}>
  <!-- ======================= HERO ======================= -->
  <section class="hero on-dark" id="top">
    <!-- Pinselflächen als Bühne: liegen hinter allem und werden nicht vorgelesen -->
    <div class="hero-paint" aria-hidden="true">
      <Brush variant="slab" color="var(--pink)" class="paint paint-pink" />
      <Brush variant="slab" color="var(--orange)" class="paint paint-orange" />
    </div>

    <div class="container container-wide hero-inner">
      <div class="hero-copy">
        <p class="hero-super">{site.supertitle}</p>

        <h1 class="hero-title">
          <Kinetic text="G-Laber" class="offset" reveal />
        </h1>

        <div class="hero-copy-body">
          <p class="hero-names">
            <span class="name-jana">Jana Jansen</span>
            <span class="name-und">und</span>
            <span class="name-roger">Roger G.</span>
          </p>

          <p class="hero-claim">{site.claim}</p>

          <div class="hero-actions" id="hoeren">
            <a class="btn btn-primary" href={`#${latestPrepared.anchorId}`}>Neueste Folge hören</a>
            <div class="hero-platforms">
              <a class="link-brush" href={site.platforms.spotify} rel="noopener">Spotify</a>
              <a class="link-brush" href={site.platforms.apple} rel="noopener">Apple Podcasts</a>
              <a class="link-brush" href={site.feedUrl} rel="noopener">RSS</a>
            </div>
          </div>
        </div>
      </div>

      <div class="hero-art">
          <p class="sticker hero-sticker"><span class="dot"></span> Neue Folge jeden Donnerstag</p>
          <img
            class="hero-cover"
            src="/img/cover-768.webp"
            srcset="/img/cover-480.webp 480w, /img/cover-640.webp 640w, /img/cover-768.webp 768w, /img/cover-1080.webp 1080w"
            sizes="(min-width: 64rem) 30rem, (min-width: 40rem) 60vw, 84vw"
            width="768" height="768"
            alt="Cover des G-Laber Podcasts: Jana Jansen und Roger G. vor Berliner Häuserfassaden, dahinter pinke und orange Pinselstriche."
            fetchpriority="high"
            decoding="async"
          />
      </div>
    </div>
  </section>

  <Marquee items={tickerItems} tone="pink" />

  <!-- ======================= NEUESTE FOLGE ======================= -->
  <section class="section latest on-paper" aria-labelledby="latest-heading">
    <div class="container" data-reveal-group>
      <div class="section-head" data-reveal>
        <p class="label">Frisch aus der Kombüse</p>
        <h2 class="section-title" id="latest-heading"><Kinetic text="Die neueste Folge" scroll /></h2>
      </div>
      <div data-reveal>
        <FeaturedEpisode episode={latest} />
      </div>
    </div>
  </section>

  <!-- ======================= ALLE FOLGEN ======================= -->
  <section class="section archive on-dark" id="folgen" aria-labelledby="folgen-heading">
    <div class="container" data-reveal-group>
      <div class="section-head archive-head" data-reveal>
        <div>
          <p class="label label-pink">Zum Nachhören</p>
          <h2 class="section-title" id="folgen-heading"><Kinetic text="Alle Folgen" scroll /></h2>
        </div>
        <p class="archive-count" aria-hidden="true">{String(feed.episodes.length).padStart(2, '0')}<span>Folgen</span></p>
      </div>

      <div class="archive-list">
        {older.map((ep) => <EpisodeRow episode={ep} />)}
      </div>

      <p class="archive-note" data-reveal>
        Alle Folgen gibt’s überall, wo es Podcasts gibt —
        <a class="link-brush" href={site.platforms.spotify} rel="noopener">Spotify</a>,
        <a class="link-brush" href={site.platforms.apple} rel="noopener">Apple Podcasts</a>
        und per <a class="link-brush" href={site.feedUrl} rel="noopener">RSS</a>.
      </p>
    </div>
  </section>

  <!-- ======================= ÜBER UNS ======================= -->
  <section class="hosts on-dark" id="hosts" aria-labelledby="hosts-heading">
    <!-- Bildband als Übergang: derselbe Foto-Ausschnitt wie auf dem Cover -->
    <div class="hosts-band">
      <img
        src="/img/hosts-wide-1440.webp"
        srcset="/img/hosts-wide-960.webp 960w, /img/hosts-wide-1440.webp 1440w, /img/hosts-wide-1920.webp 1920w"
        sizes="100vw"
        width="1440" height="691"
        alt="Jana Jansen und Roger G. nebeneinander vor Berliner Altbauten."
        loading="lazy"
        decoding="async"
      />
      <div class="hosts-band-copy">
        <p class="label label-orange">Wer labert hier eigentlich?</p>
        <h2 class="hosts-title offset" id="hosts-heading"><Kinetic text="Ostsee trifft Rheinland" scroll /></h2>
      </div>
    </div>

    <div class="container hosts-grid" data-reveal-group>
      {site.hosts.map((h) => (
        <article class:list={['host', `tone-${h.tone}`]} data-reveal>
          <div class="host-media">
            <img
              src={h.image}
              width="800" height="1000"
              alt={`${h.name} — ${h.role}`}
              loading="lazy"
              decoding="async"
            />
            <h3 class="host-name">{h.name}</h3>
          </div>
          <div class="host-body">
            <p class="label host-role">{h.role}</p>
            <p class="host-bio">{h.bio}</p>
            <div class="host-links">
              {h.links.map((l) => (
                <a class="btn btn-ghost" href={l.url} rel="noopener">
                  {l.label}<span class="sr-only"> von {h.name}</span>
                </a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <Marquee items={tickerItems} tone="orange" reverse />

  <!-- ======================= KONTAKT ======================= -->
  <section class="section kontakt on-pink" id="kontakt" aria-labelledby="kontakt-heading">
    <!-- Gemalter Übergang in den schwarzen Footer -->
    <Brush variant="slab" color="var(--black)" class="kontakt-edge" />

    <div class="container kontakt-inner" data-reveal-group>
      <h2 class="kontakt-title" id="kontakt-heading" data-reveal>
        <Kinetic text="Laber" scroll /><br />
        <Kinetic text="mit" class="kontakt-mit" scroll startIndex={5} /><br />
        <Kinetic text="uns." scroll startIndex={8} />
      </h2>

      <div class="kontakt-copy" data-reveal>
        <p class="kontakt-text">
          Themen, Fragen, Seemannsgarn? Eure Geschichten landen in der nächsten Folge.
          Immer her damit — Flaschenpost wird auch akzeptiert, E-Mail ist schneller.
        </p>
        <a class="kontakt-mail" href={`mailto:${site.email}`}>
          {site.email}
          <Brush variant="stroke" color="var(--black)" class="kontakt-mail-rule" />
        </a>
        <p class="kontakt-hint">Oder schreibt uns auf Instagram — bei Jana oder bei Roger.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ============================================================
     HERO — Poster: Wortbild über die volle Breite, darunter die
     Namenszeile und das Cover als gekipptes Plakat.
     ============================================================ */
  .hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(1.75rem, 4vw, 3rem) clamp(3rem, 6vw, 4.5rem);
  }
  @media (min-width: 64rem) {
    /* „nahezu der gesamte erste Viewport“ — svh, damit mobile Browserleisten
       nicht in die Höhe reinrechnen. */
    .hero { min-height: calc(100svh - 4.5rem); display: grid; align-items: center; }
  }

  .hero-paint { position: absolute; inset: 0; pointer-events: none; }
  /* Zwei gezielte Striche statt flächiger Tapete: der pinke kommt hinter dem
     Cover hervor, der orange liegt unter dem CTA-Block. */
  .paint { position: absolute; display: none; }
  @media (min-width: 48rem) {
    .paint { display: block; }
  }
  .paint-pink {
    top: 4%; right: -10%;
    width: 46vw; height: 16vh;
    rotate: -24deg;
    opacity: 0.9;
  }
  .paint-orange {
    bottom: 6%; left: -12%;
    width: 30vw; height: 9vh;
    rotate: 8deg;
    opacity: 0.85;
  }

  .hero-inner {
    position: relative;
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }
  @media (min-width: 64rem) {
    /* Links das Wortbild als Gestaltungsfläche, rechts das Cover als Plakat. */
    .hero-inner {
      grid-template-columns: minmax(0, 1.9fr) minmax(17rem, 1fr);
      align-items: center;
    }
  }

  .hero-copy { display: grid; justify-items: start; min-width: 0; }

  .hero-super {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 3vw, 1.9rem);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 0.3rem;
  }

  /* Der Grad ist so gewählt, dass das Wortbild seine Spalte füllt:
     „G-LABER“ ist in Bebas rund 2,6 em breit. */
  .hero-title {
    font-size: min(36vw, 20rem);
    line-height: 0.78;
    letter-spacing: 0.005em;
  }
  @media (min-width: 64rem) {
    .hero-title { font-size: min(21.5vw, 21rem); }
  }

  .hero-copy-body {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
  }

  .hero-names {
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 4.6vw, 2.9rem);
    line-height: 0.95;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .name-jana { color: var(--orange); }
  .name-roger { color: var(--pink); }
  .name-und { color: var(--white); }

  .hero-claim {
    max-width: 32ch;
    font-size: var(--text-lg);
    color: var(--gray);
  }

  .hero-actions {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    scroll-margin-top: 6rem;
  }
  .hero-platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .hero-platforms a { color: var(--gray); }
  .hero-platforms a:hover { color: var(--white); }

  .hero-art { position: relative; justify-self: center; width: min(30rem, 84vw); }
  @media (min-width: 64rem) {
    .hero-art { width: 100%; justify-self: end; }
  }
  .hero-cover {
    width: 100%;
    border: var(--edge) solid var(--white);
    rotate: -2.5deg;
    box-shadow: 1rem 1rem 0 var(--pink);
    transition: rotate 0.45s var(--ease-out), box-shadow 0.45s var(--ease-out);
  }
  .hero-art:hover .hero-cover { rotate: 0deg; box-shadow: 1.25rem 1.25rem 0 var(--orange); }

  .hero-sticker {
    position: absolute;
    z-index: 2;
    top: -1.1rem;
    left: -0.6rem;
    max-width: calc(100% - 1rem);
  }

  /* ============================================================
     ALLE FOLGEN
     ============================================================ */
  .archive-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .archive-count {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 0.8;
    color: var(--orange);
  }
  .archive-count span {
    display: block;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gray-dim);
    margin-top: 0.4rem;
  }
  .archive-note {
    margin-top: 2.5rem;
    font-size: var(--text-sm);
    color: var(--gray-dim);
  }
  .archive-note a { color: var(--white); }

  /* ============================================================
     ÜBER UNS
     ============================================================ */
  .hosts { padding-bottom: var(--space-section); }

  .hosts-band { position: relative; }
  .hosts-band img {
    width: 100%;
    height: clamp(16rem, 38vw, 30rem);
    object-fit: cover;
    object-position: center 12%;
    filter: grayscale(0.15) contrast(1.05);
  }
  .hosts-band::after {
    /* Verlauf nach unten, damit die Überschrift auf dem Foto sicher liest */
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--black) 4%, #0b0b0cd9 32%, #0b0b0c40 70%, transparent);
  }
  .hosts-band-copy {
    position: absolute;
    z-index: 1;
    left: 0; right: 0; bottom: 0;
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    padding: 0 var(--gutter) clamp(1.5rem, 3vw, 2.5rem);
  }
  .hosts-title { font-size: var(--display-lg); max-width: 14ch; }

  .hosts-grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  @media (min-width: 52rem) {
    .hosts-grid { grid-template-columns: 1fr 1fr; align-items: start; }
    /* Leichter Versatz der zweiten Spalte — Collage statt Zwillingskarten. */
    .hosts-grid > :last-child { margin-top: clamp(2rem, 5vw, 4.5rem); }
  }

  .host { display: grid; gap: 1.5rem; }
  .host-media { position: relative; }
  .host-media img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: var(--edge) solid var(--white);
  }
  .tone-orange .host-media img { box-shadow: 0.9rem 0.9rem 0 var(--orange); }
  .tone-pink .host-media img { box-shadow: 0.9rem 0.9rem 0 var(--pink); }

  /* Der Name liegt halb auf dem Foto, halb daneben — mit hartem Schatten,
     damit er auf jedem Bildbereich lesbar bleibt. */
  .host-name {
    position: absolute;
    left: -0.04em;
    bottom: -0.16em;
    font-size: clamp(2.2rem, 7vw, 4.4rem);
    line-height: 0.82;
    max-width: 7ch;
    text-shadow: 0.06em 0.06em 0 var(--black), -0.02em -0.02em 0 var(--black);
  }
  .tone-orange .host-name { color: var(--orange); }
  .tone-pink .host-name { color: var(--pink); }

  .host-body { display: grid; gap: 1rem; justify-items: start; padding-top: 1.25rem; }
  .host-role { color: var(--gray-dim); }
  .host-bio { max-width: 42ch; color: var(--gray); }
  .host-links { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .host-links .btn { --hard: 0.35rem; }

  /* ============================================================
     KONTAKT — visueller Schlusspunkt in Cover-Pink
     ============================================================ */
  .kontakt {
    position: relative;
    overflow: clip;
    padding-bottom: clamp(5rem, 8vw, 9rem);
  }
  /* Der Strich ist um 180° gedreht: die ausgefranste Kante zeigt nach oben
     in die pinke Fläche, die satte Kante schließt bündig an den Footer an. */
  .kontakt-edge {
    position: absolute;
    left: -2%; right: -2%;
    bottom: -2px;
    width: 104%;
    height: clamp(2.5rem, 5vw, 4.5rem);
    rotate: 180deg;
    pointer-events: none;
  }

  .kontakt-inner {
    position: relative;
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 56rem) {
    .kontakt-inner { grid-template-columns: minmax(0, auto) minmax(0, 1fr); }
  }

  .kontakt-title {
    font-size: clamp(3.5rem, 13vw, 9.5rem);
    line-height: 0.78;
    color: var(--black);
  }
  .kontakt-mit { color: var(--white); }

  .kontakt-copy { display: grid; gap: 1.5rem; justify-items: start; }
  .kontakt-text { max-width: 38ch; font-size: var(--text-lg); }

  /* Die E-Mail-Adresse ist der Haupt-CTA: Display-Grad statt Button. */
  .kontakt-mail {
    position: relative;
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 5.6vw, 3.75rem);
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--black);
    padding-bottom: 0.3rem;
    transition: color 0.2s, transform 0.25s var(--ease-out);
  }
  .kontakt-mail-rule {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 0.6rem;
    transform: scaleX(1);
    transform-origin: left;
    transition: transform 0.35s var(--ease-expo);
  }
  .kontakt-mail:hover { color: var(--white); transform: translate(-3px, -3px); }
  .kontakt-mail:hover .kontakt-mail-rule { transform: scaleX(1.03); }

  .kontakt-hint { font-size: var(--text-sm); font-weight: 600; }
</style>
