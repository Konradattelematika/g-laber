---
/**
 * Kinetische Typo: zerlegt Text in Buchstaben-Spans für Lade- (reveal) und
 * Hover-Animationen — inspiriert von Festival-Sites. Barrierefrei: die zerlegten
 * Wörter sind aria-hidden, davor steht der echte Text visuell versteckt
 * (.sr-only), damit Screenreader die Überschrift sauber vorlesen. Rein
 * serverseitig gerendert, die Animationen laufen per CSS (auch ohne JS).
 */
interface Props {
  text: string;
  class?: string;
  /** Buchstaben-für-Buchstaben beim Laden einblenden (nur für den Hero-Aufruf) */
  reveal?: boolean;
  /** Reveal erst beim Scrollen in den Viewport (Abschnitts-Überschriften) */
  scroll?: boolean;
  /** Start-Index für den Stagger, damit mehrzeilige Titel durchlaufen */
  startIndex?: number;
}

const { text, class: cls = '', reveal = false, scroll = false, startIndex = 0 } = Astro.props;

let idx = startIndex;
const words = text.split(' ').map((word) => ({
  chars: [...word].map((ch) => ({ ch, i: idx++ })),
}));
---

<span class:list={['kinetic', { reveal, scroll }, cls]}>
  <span class="sr-only">{text}</span>
  {words.map((word, wi) => (
    <>
      {wi > 0 ? ' ' : ''}
      <span class="k-word" aria-hidden="true">
        {word.chars.map((c) => (
          <span class="char" style={`--i:${c.i}`}>{c.ch}</span>
        ))}
      </span>
    </>
  ))}
</span>
