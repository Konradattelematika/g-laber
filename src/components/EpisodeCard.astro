---
interface Props {
  episode: {
    title: string;
    slug: string;
    pubDate: string;
    duration: string;
    durationSeconds: number;
    description: string;
    audioUrl: string;
    episodeNumber: number;
  };
  /** 'feature' = große Karte für die neueste Folge */
  variant?: 'feature' | 'list';
}

const { episode, variant = 'list' } = Astro.props;

const date = new Date(episode.pubDate);
const dateHuman = date.toLocaleDateString('de-DE', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Berlin',
});
const dateISO = date.toISOString().slice(0, 10);

const durationHuman = episode.duration.replace(/^00:/, '').replace(/^0/, '') // "1:25:50" bzw. "28:40"
  .replace(/^(\d+):(\d+):/, '$1 Std $2 Min ').replace(/^(\d+):(\d+)$/, '$1 Min');

// Beschreibung: erster Absatz als Teaser, Rest einklappbar
const [teaser, ...rest] = episode.description.split('\n\n');
const more = rest.join('\n\n').replace(/Schreibt (uns )?immer gerne an.*$/s, '').trim();
---

<article class={`episode ${variant}`} id={`folge-${episode.episodeNumber}`}>
  <header class="episode-head">
    <span class="episode-number" aria-hidden="true">{String(episode.episodeNumber).padStart(2, '0')}</span>
    <div>
      <h3 class="episode-title">{episode.title}</h3>
      <p class="episode-meta">
        Folge {episode.episodeNumber} · <time datetime={dateISO}>{dateHuman}</time> · {durationHuman}
      </p>
    </div>
  </header>

  <p class="episode-teaser">{teaser}</p>
  {more && (
    <details class="episode-more">
      <summary>Mehr lesen</summary>
      <p>{more}</p>
    </details>
  )}

  <div class="player" data-player>
    <audio preload="none" src={episode.audioUrl}></audio>
    <button class="player-toggle" type="button" data-play aria-label={`Folge ${episode.episodeNumber} „${episode.title}“ abspielen`}>
      <svg class="icon-play" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M8 5.5v13a1 1 0 0 0 1.53.85l10.2-6.5a1 1 0 0 0 0-1.7L9.53 4.65A1 1 0 0 0 8 5.5Z"/></svg>
      <svg class="icon-pause" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/></svg>
    </button>
    <div class="player-track">
      <input type="range" min="0" max={episode.durationSeconds} value="0" step="1" data-seek aria-label={`Abspielposition in „${episode.title}“`} />
      <div class="player-times" aria-hidden="true">
        <span data-current>0:00</span>
        <span data-total>{episode.duration.replace(/^00:/, '').replace(/^0(\d)/, '$1')}</span>
      </div>
    </div>
  </div>
</article>

<style>
  .episode {
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.4rem, 3vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: var(--white);
    color: var(--ink);
    box-shadow: 0 10px 34px -18px rgb(11 46 60 / 0.25);
    border: 1px solid rgb(11 46 60 / 0.07);
  }
  .episode.feature {
    background: var(--petrol-deep);
    color: var(--white);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-card);
  }

  .episode-head {
    display: flex;
    gap: 1.1rem;
    align-items: baseline;
  }
  .episode-number {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    line-height: 1;
    color: var(--apricot-strong);
  }
  .feature .episode-number { color: var(--apricot); }
  .episode-title { font-size: var(--display-md); }
  .feature .episode-title { font-size: var(--display-lg); }
  .episode-meta {
    margin-top: 0.45rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .feature .episode-meta { color: color-mix(in srgb, var(--white) 65%, transparent); }

  .episode-teaser { max-width: 62ch; }
  .feature .episode-teaser { color: color-mix(in srgb, var(--white) 88%, transparent); }

  .episode-more summary {
    cursor: pointer;
    width: fit-content;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--burgundy);
  }
  .feature .episode-more summary { color: var(--apricot); }
  .episode-more[open] summary { margin-bottom: 0.6rem; }
  .episode-more p { max-width: 62ch; white-space: pre-line; }

  /* Player */
  .player {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.3rem;
  }
  .player-toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    border: none;
    border-radius: 50%;
    background: var(--petrol);
    color: var(--white);
    transition: transform 0.25s var(--ease-out), background 0.2s;
  }
  .feature .player-toggle {
    background: var(--apricot);
    color: var(--petrol-darker);
    width: 4rem;
    height: 4rem;
  }
  .player-toggle:hover { transform: scale(1.07); }
  .icon-play { translate: 1px 0; }
  .player .icon-pause { display: none; }
  .player.is-playing .icon-pause { display: block; }
  .player.is-playing .icon-play { display: none; }

  .player-track { flex: 1; display: grid; gap: 0.15rem; }
  .player-times {
    display: flex;
    justify-content: space-between;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
  }
  .feature .player-times { color: color-mix(in srgb, var(--white) 65%, transparent); }

  input[type='range'] {
    width: 100%;
    height: 1.2rem;
    margin: 0;
    appearance: none;
    background: transparent;
    --fill: 0%;
  }
  input[type='range']::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 3px;
    background: linear-gradient(to right, var(--apricot-strong) var(--fill), rgb(11 46 60 / 0.15) var(--fill));
  }
  .feature input[type='range']::-webkit-slider-runnable-track {
    background: linear-gradient(to right, var(--apricot) var(--fill), rgb(255 255 255 / 0.18) var(--fill));
  }
  input[type='range']::-webkit-slider-thumb {
    appearance: none;
    width: 16px;
    height: 16px;
    margin-top: -5px;
    border-radius: 50%;
    background: var(--white);
    border: 3px solid var(--apricot-strong);
    transition: transform 0.15s;
  }
  input[type='range']::-webkit-slider-thumb:hover { transform: scale(1.2); }
  input[type='range']::-moz-range-track {
    height: 6px;
    border-radius: 3px;
    background: rgb(11 46 60 / 0.15);
  }
  .feature input[type='range']::-moz-range-track { background: rgb(255 255 255 / 0.18); }
  input[type='range']::-moz-range-progress {
    height: 6px;
    border-radius: 3px;
    background: var(--apricot-strong);
  }
  input[type='range']::-moz-range-thumb {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--white);
    border: 3px solid var(--apricot-strong);
  }
</style>
