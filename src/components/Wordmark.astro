---
/**
 * Das Wortbild „G-LABER“ im Offset-Look des Covers: weiße Versalien mit
 * orange (oben/links) und pink (unten/rechts) versetzten Ebenen.
 * Die Größe steuert der Aufrufer über CSS (font-size auf .wordmark).
 */
interface Props {
  /** Als Link auf die Startseite rendern (Header) */
  href?: string;
  class?: string;
  /** Offset-Effekt ausschalten (z. B. auf farbigem Grund) */
  plain?: boolean;
  label?: string;
}
// `rest` reicht Astros Scope-Attribut der aufrufenden Komponente weiter.
const { href, class: cls = '', plain = false, label, ...rest } = Astro.props;
const Tag = href ? 'a' : 'span';
---
<Tag
  {...rest}
  class:list={['wordmark', { offset: !plain }, cls]}
  {...href ? { href, 'aria-label': label ?? 'G-Laber Podcast — Startseite' } : { 'aria-hidden': 'true' }}
>G-Laber</Tag>

<style>
  .wordmark {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    line-height: 0.82;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
  }
</style>
