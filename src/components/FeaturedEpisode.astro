---
/**
 * Titelfolge: asymmetrisches Editorial-Layout auf Off-White.
 * Die Folgennummer ist hier kein Badge, sondern ein typografisches
 * Gestaltungselement im Offset-Look des Covers.
 */
import Player from './Player.astro';
import Brush from './Brush.astro';
import { prepare, type Episode } from '../lib/episode';
import { site } from '../data/site';

interface Props { episode: Episode }
const ep = prepare(Astro.props.episode);
---
<article class="feature on-paper" id={ep.anchorId}>
  <div class="feature-num" aria-hidden="true">
    <span class="numeral offset-ink">{ep.numeral}</span>
  </div>

  <div class="feature-body">
    <p class="feature-meta">
      <span class="feature-kicker">{ep.kicker}</span>
      <span class="sep" aria-hidden="true">/</span>
      <time datetime={ep.dateISO}>{ep.dateHuman}</time>
      <span class="sep" aria-hidden="true">/</span>
      <span>{ep.durationHuman}</span>
    </p>

    <h3 class="feature-title">{ep.title}</h3>

    <Brush variant="stroke" color="var(--orange)" class="feature-rule" style="height:0.85rem;max-width:22rem;" />

    <p class="feature-teaser">{ep.teaser}</p>
    {ep.more && (
      <details class="more">
        <summary><span>Mehr lesen</span></summary>
        <p>{ep.more}</p>
      </details>
    )}

    <Player episode={ep} size="feature" />

    <div class="feature-actions">
      <a class="btn btn-primary" href={site.platforms.spotify} rel="noopener">Auf Spotify hören</a>
      <a class="btn btn-ghost" href={site.platforms.apple} rel="noopener">Apple Podcasts</a>
    </div>
  </div>
</article>

<style>
  .feature {
    position: relative;
    display: grid;
    gap: clamp(0.5rem, 2vw, 2.5rem);
    color: var(--black);
  }
  @media (min-width: 56rem) {
    /* Die Nummer steht in einer eigenen Spalte und ragt bewusst über die
       Blockkante hinaus — Poster-Geste statt sauberer Karten-Raster. */
    .feature { grid-template-columns: minmax(0, auto) minmax(0, 1fr); align-items: start; }
    .feature-num { margin-left: calc(var(--gutter) * -0.7); position: sticky; top: 7rem; }
  }

  .feature-num .numeral {
    display: block;
    font-size: clamp(5rem, 17vw, 14rem);
  }

  .feature-body { display: grid; gap: 1.25rem; justify-items: start; }

  .feature-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .feature-kicker { color: var(--black); }
  .sep { color: var(--orange-deep); }

  .feature-title {
    font-size: clamp(2.6rem, 7.5vw, 6rem);
    line-height: 0.85;
    max-width: 16ch;
  }

  .feature-rule { width: 100%; }

  .feature-teaser {
    max-width: 58ch;
    font-size: var(--text-lg);
    line-height: 1.55;
  }

  .more summary {
    cursor: pointer;
    list-style: none;
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding-block: 0.4rem;
  }
  .more summary::-webkit-details-marker { display: none; }
  .more summary span {
    border-bottom: 3px solid var(--orange);
    padding-bottom: 2px;
  }
  .more summary span::after { content: ' ↓'; }
  .more[open] summary span::after { content: ' ↑'; }
  .more p { margin-top: 0.7rem; max-width: 58ch; white-space: pre-line; }

  .feature :global(.player) { width: min(100%, 34rem); margin-top: 0.5rem; }

  .feature-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.2rem;
    margin-top: 0.6rem;
  }
</style>
